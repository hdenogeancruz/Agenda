@page "/contactos/nuevo"

<h3>Nuevo Contacto</h3>

<EditForm Model="Contacto" OnValidSubmit="GuardarAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="nombre" class="form-label">Nombre *</label>
        <InputText id="nombre"
                   class="form-control"
                   @bind-Value="Contacto.Nombre" />
        <ValidationMessage For="@(() => Contacto.Nombre)" />
    </div>

    <div class="mb-3">
        <label for="apellido" class="form-label">Apellido</label>
        <InputText id="apellido"
                   class="form-control"
                   @bind-Value="Contacto.Apellido" />
        <ValidationMessage For="@(() => Contacto.Apellido)" />
    </div>

    <div class="mb-3">
        <label for="telefono" class="form-label">Teléfono</label>
        <InputText id="telefono"
                   class="form-control"
                   @bind-Value="Contacto.Telefono" />
        <ValidationMessage For="@(() => Contacto.Telefono)" />
    </div>

    <div class="mb-3">
        <label for="correo" class="form-label">Correo electrónico *</label>
        <InputText id="correo"
                   type="email"
                   class="form-control"
                   @bind-Value="Contacto.CorreoElectronico" />
        <ValidationMessage For="@(() => Contacto.CorreoElectronico)" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    <div class="alert alert-success mt-3">
        @Mensaje
    </div>
}